{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "electron", "vitest/globals"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/main/electron-main.ts",
    "src/main/preload.ts",
    "src/renderer",
    "index.html",
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "vite.renderer.config.ts",
    "forge.config.ts"
  ],
  "exclude": ["node_modules", ".vite"]
}
